    "deny": [
      "Bash(git tag:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --tags:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git commit --amend:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(gh pr merge --squash:*)",
      "Bash(gh pr merge --delete-branch:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git clean:*)",
      "Bash(npm publish:*)",
      "Bash(npm unpublish:*)"
    ]
  }
}
